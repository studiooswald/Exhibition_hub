# Anthropic API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Login-Passwort für die App, mindestens 8 Zeichen
APP_PASSWORD=bitte-aendern

# Zufälliger String zum Signieren der Anmeldung, mindestens 16 Zeichen
SESSION_SECRET=bitte-durch-zufallsstring-ersetzen

# Nummer, die die NÄCHSTE Notiz bekommen soll. Damit schließt der Bot an die
# Notizen an, die schon in Obsidian liegen: heißt die letzte dort
# "26 - MÄR ...", gehört hier 27 hin. Der Wert greift nur, solange der Bot
# selbst noch keine Notiz gespeichert hat – danach zählt er allein weiter.
START_NR=1

# Optional: Zeitzone für "heute" und die Datumsfelder (Standard: Europe/Berlin)
# TIMEZONE=Europe/Berlin

# Optional: Modell (Standard: claude-sonnet-5)
# MODEL=claude-sonnet-5

# Optional: Wie viele tägliche Backups aufgehoben werden (Standard: 14)
# BACKUP_KEEP=14

# Optional: Wie lange man angemeldet bleibt, in Tagen (Standard: 365)
# SESSION_DAYS=365

# Optional: Beim Speichern wird die Ausstellungsseite einmal angefragt, um tote
# Links zu erkennen. Mit 0 abschalten, falls der Server nicht ins Netz darf.
# LINK_CHECK=1

# Nur zum Ausprobieren ohne API-Key: simulierter Bot
# MOCK_AGENT=1
