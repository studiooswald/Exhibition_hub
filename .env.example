# Anthropic API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Login-Passwort für die App (frei wählbar)
APP_PASSWORD=bitte-aendern

# Zufälliger String zum Signieren der Session (z.B. 64 Zufallszeichen)
SESSION_SECRET=bitte-durch-zufallsstring-ersetzen

# Nummer, die die NÄCHSTE Notiz bekommen soll. Damit schließt der Bot an die
# Notizen an, die schon in Obsidian liegen. Beispiel: liegt dort zuletzt
# "26 - MÄR ...", dann hier 27 eintragen. Wirkt nur, solange noch keine Notiz
# im Bot gespeichert ist – danach zählt er selbst weiter.
START_NR=1

# Optional: Zeitzone für "heute" und für die Datumsfelder (Standard: Europe/Berlin)
# TIMEZONE=Europe/Berlin

# Optional: Modell (Standard: claude-sonnet-5)
# MODEL=claude-sonnet-5

# Optional: Wie viele tägliche Backups aufgehoben werden (Standard: 14)
# BACKUP_KEEP=14

# Optional: Wie lange man angemeldet bleibt, in Tagen (Standard: 365)
# SESSION_DAYS=365

# Nur für Tests ohne API-Key: simulierter Agent
# MOCK_AGENT=1
