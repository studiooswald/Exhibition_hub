# Bot-Token von @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:AA...

# Deine Telegram-Nutzer-ID – nur diese Person darf den Bot benutzen.
# Die ID sagt dir @userinfobot in Telegram.
TELEGRAM_USER_ID=123456789

# Anthropic API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Nummer, die die NÄCHSTE Notiz bekommen soll, damit der Bot an die Notizen
# anschließt, die schon in Obsidian liegen. Lässt sich auch jederzeit im Chat
# mit /nummer ändern – dann ist dieser Wert egal.
START_NR=1

# Optional: Zeitzone für "heute" und die Datumsfelder (Standard: Europe/Berlin)
# TIMEZONE=Europe/Berlin

# Optional: Modell (Standard: claude-sonnet-5)
# MODEL=claude-sonnet-5

# Optional: Nach so vielen Stunden Pause gilt die nächste Nachricht als neue
# Ausstellung statt als Korrektur der letzten (Standard: 6)
# CONVERSATION_TIMEOUT_HOURS=6

# Optional: Wie viele tägliche Backups aufgehoben werden (Standard: 14)
# BACKUP_KEEP=14

# Optional: Beim Speichern wird die Ausstellungsseite einmal angefragt, um tote
# Links zu erkennen. Mit 0 abschalten, falls der Server nicht ins Netz darf.
# LINK_CHECK=1

# Nur zum Ausprobieren ohne API-Key: simulierter Bot
# MOCK_AGENT=1
