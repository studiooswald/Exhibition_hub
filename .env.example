# Anthropic API-Key von https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Login-Passwort für die App (frei wählbar)
APP_PASSWORD=bitte-aendern

# Zufälliger String zum Signieren der Session (z.B. 64 Zufallszeichen)
SESSION_SECRET=bitte-durch-zufallsstring-ersetzen

# Optional: Modell (Standard: claude-sonnet-5)
# MODEL=claude-sonnet-5

# Nur für Tests ohne API-Key: simulierter Agent
# MOCK_AGENT=1
