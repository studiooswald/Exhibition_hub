# API-Key von https://console.anthropic.com (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Passwort für den Zugriff auf die Web-App (frei wählbar)
APP_PASSWORD=

# Optional: anderes Claude-Modell (Default: claude-opus-4-8)
# CLAUDE_MODEL=claude-opus-4-8

# Optional: Port (Default: 3000)
# PORT=3000
